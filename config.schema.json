{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "required": [
            "default"
          ],
          "properties": {
            "default": {
              "enum": [
                "allow",
                "ask",
                "reject"
              ]
            }
          },
          "additionalProperties": false
        }
      ],
      "items": {
        "type": "object",
        "required": [
          "name",
          "command",
          "action"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "action": {
            "enum": [
              "allow",
              "ask",
              "reject"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
